                PreviewTextInput="HandleTextOuterPreview" TextInput="HandleTextOuterBubble">
                <Border.Resources>
                  <Style TargetType="Button">
                    <Setter Property="BorderBrush" Value="#FFD3DCE8"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="4,4"/>
                    <Style.Triggers>
                      <Trigger Property="IsFocused" Value="true">
                        <Setter Property="BorderBrush" Value="#FFF0872E"/>
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="true">
                        <Setter Property="BorderBrush" Value="#FF2F6FE4"/>
