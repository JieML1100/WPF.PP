		  Background="{StaticResource SurfaceSoft}"
		  BorderBrush="{StaticResource Border}" BorderThickness="1">
		  <StackPanel Orientation="Horizontal">
			<TextBlock Text="订单详情" Foreground="{StaticResource Accent}"
			  Width="76"/>
			<TextBlock Text="{Binding Customer}" Width="120"/>
			<TextBlock Text="{Binding Region}" Width="64"/>
			<TextBlock Text="{Binding Stage}" Width="82"/>
