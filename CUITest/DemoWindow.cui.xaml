                <TextBlock x:Name="wpfAncestorValue" AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type StackPanel}}}" Height="24" Text="RelativeSource FindAncestor"/>
