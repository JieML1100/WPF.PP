		<Setter Property="Padding" Value="4,0"/>
	  </Style>
	  <ControlTemplate x:Key="OrderCustomerEditingTemplate" TargetType="TextBox">
		<!-- The native TextBox glyph layer is owned by the TextBox; keep its
